# Example TestFly configuration for local development.
# Copy this file to testfly.yml and fill in real credentials, or keep testfly.yml
# without secrets and export the environment variables referenced below.

browser:
  name: chrome
  headless: true
  arguments:
    - --start-maximized
    - --disable-notifications
    - --remote-allow-origins=*
  capabilities:
    acceptInsecureCerts: true
    pageLoadStrategy: eager

execution:
  mode: local
  baseUrl: https://www.saucedemo.com/
  gridUrl: http://localhost:4444/wd/hub
  parallel: methods
  threadCount: 4
  maxActiveSessions: 4

api:
  baseUrl: https://fakeapi.net
  timeoutSeconds: 30
  logBody: false

retry:
  enabled: false
  maxAttempts: 2

timeouts:
  explicit: 10
  pageLoad: 30

reporting:
  allureEnabled: true
  reportPortal:
    enabled: false
    endpoint: ${REPORTPORTAL_ENDPOINT:-https://reportportal.example.com}
    apiKey: ${REPORTPORTAL_API_KEY}
    project: demo-web
    launch: "Demo Web- DEV"
    description: "My awesome launch"
    attributes: "env:dev"
    mode: default

ai:
  failureAnalysis: false
  provider: openai-compatible
  baseUrl: https://api.deepseek.com
  apiKey: ${DEEPSEEK_API_KEY}
  model: deepseek-v4-flash
  language: tr
  timeoutSeconds: 20
