  "cards": [
    {
      "dot": "emerald",
      "title": "API-First Setup & Seeding",
      "items": [
        "ApiClient executes REST calls (POST /api/seed) in milliseconds",
        "Tokens and generated database entity IDs store in ThreadLocal ScenarioContext",
        "Avoids brittle and slow UI login forms by seeding state directly"
      ]
    },
    {
      "dot": "cyan",
      "title": "Browser State Injection",
      "items": [
        "StorageHelper directly seeds session cookies and localStorage into WebDriver",
        "Browser opens target page immediately in an authenticated state",
        "WaitEngine and SmartLocator execute high-speed user journeys"
      ]
    },
    {
      "dot": "rose",
      "title": "Dual Assertions & Timeline",
      "items": [
        "UI assertions verify rendered elements, text, and visual appearance",
        "REST assertions verify database persistence and backend state",
        "StepLogger combines API logs and UI screenshots in a single HTML report"
      ]
    }
  ]
