  "cards": [
    {
      "dot": "emerald",
      "title": "İzole WebDriver Yönetimi",
      "items": [
        "BaseTest ve DriverManager ile tam ThreadLocal paralel çalışma güvenliği",
        "testfly.yml üzerinden merkezi tarayıcı, headless ve CDP yapılandırması",
        "per-test ve per-suite yaşam döngüsü ile optimize kaynak kullanımı"
      ]
    },
    {
      "dot": "cyan",
      "title": "SmartLocator & Auto-Wait",
      "items": [
        "Erişilebilirlik odaklı semantik konumlandırıcılar (getByRole, getByText)",
        "WaitEngine ile sıfır Thread.sleep(): eleman görünürlüğü ve tıklanabilirlik",
        "Geçici ağ gecikmelerinde otomatik yeniden deneme (@Retryable) desteği"
      ]
    },
    {
      "dot": "rose",
      "title": "Görsel Doğrulama & Raporlama",
      "items": [
        "SeleniumAssert ile akıcı ve tip güvenli DOM durumu kontrolleri",
        "Hata anında otomatik tam sayfa ekran görüntüsü yakalama mekanizması",
        "Tek tıkla incelenebilir etkileşimli TestFly HTML rapor çıktısı"
      ]
    }
  ]
