# TestFly local integration-test credentials
# Copy this file to .env, fill in real values, and source it before running integration tests:
#   export $(cat .env | xargs)
#   mvn verify -Preal-backends

# Required for AiFailureAnalyzerIntegrationTest
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Required only if you enable ReportPortal in testfly.yml
REPORTPORTAL_API_KEY=your-reportportal-api-key-here
REPORTPORTAL_ENDPOINT=https://reportportal.example.com
