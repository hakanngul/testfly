{
  "name": "testfly-mobile-inspector",
  "displayName": "TestFly Inspector",
  "description": "Inspect iOS and Android screens through mobilecli and web pages in Chrome or Edge: screenshot, UI or DOM tree, element details and ready-to-paste TestFly @MobileFind fields and Locator declarations.",
  "version": "0.4.0",
  "publisher": "hakanngul",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hakanngul/testfly.git",
    "directory": "tools/vscode-mobile-inspector"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "mobilecli",
    "testfly",
    "appium",
    "inspector",
    "ios",
    "android",
    "locator",
    "selenium",
    "chrome"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "testflyInspector.open",
        "title": "Open Mobile Inspector",
        "category": "TestFly",
        "icon": "$(device-mobile)"
      },
      {
        "command": "testflyInspector.openBrowser",
        "title": "Open Browser Inspector",
        "category": "TestFly",
        "icon": "$(globe)"
      }
    ],
    "configuration": {
      "title": "TestFly Inspector",
      "properties": {
        "testflyInspector.serverUrl": {
          "type": "string",
          "default": "http://localhost:12000",
          "description": "URL of the mobilecli server (JSON-RPC at /rpc)."
        },
        "testflyInspector.mobilecliPath": {
          "type": "string",
          "default": "mobilecli",
          "description": "mobilecli executable used to start the server when it is not running."
        },
        "testflyInspector.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Run 'mobilecli server start' when a local server does not answer."
        },
        "testflyInspector.autoRefreshAfterAction": {
          "type": "boolean",
          "default": true,
          "description": "Read the screen again after a tap, swipe, text or button action."
        },
        "testflyInspector.browserPath": {
          "type": "string",
          "default": "",
          "description": "Chrome, Edge or Chromium executable for the Browser Inspector. Empty: the installed Chrome, Edge or Chromium is found automatically."
        },
        "testflyInspector.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "While an inspector is open, show above each TestFly locator in Java files how many elements it matches on the inspected screen or page."
        },
        "testflyInspector.testIdAttribute": {
          "type": "string",
          "default": "data-testid",
          "description": "Attribute that getByTestId() reads; keep it equal to locators.testIdAttribute in your TestFly configuration."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testflyInspector",
          "title": "TestFly",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "testflyInspector": [
        {
          "type": "webview",
          "id": "testflyInspector.home",
          "name": "Inspector"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "testflyInspector.open",
          "when": "view == testflyInspector.home",
          "group": "navigation@1"
        },
        {
          "command": "testflyInspector.openBrowser",
          "when": "view == testflyInspector.home",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.js",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
