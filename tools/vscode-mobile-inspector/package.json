{
  "name": "testfly-mobile-inspector",
  "displayName": "TestFly Mobile Inspector",
  "description": "Inspect iOS and Android screens through mobilecli: live screenshot, UI tree with @eN refs, element details and ready-to-paste TestFly @MobileFind selectors.",
  "version": "0.1.0",
  "publisher": "hakanngul",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hakanngul/testfly.git",
    "directory": "tools/vscode-mobile-inspector"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Testing", "Other"],
  "keywords": ["mobilecli", "testfly", "appium", "inspector", "ios", "android"],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "testflyInspector.open",
        "title": "Open Mobile Inspector",
        "category": "TestFly",
        "icon": "$(device-mobile)"
      }
    ],
    "configuration": {
      "title": "TestFly Mobile Inspector",
      "properties": {
        "testflyInspector.serverUrl": {
          "type": "string",
          "default": "http://localhost:12000",
          "description": "URL of the mobilecli server (JSON-RPC at /rpc)."
        },
        "testflyInspector.mobilecliPath": {
          "type": "string",
          "default": "mobilecli",
          "description": "mobilecli executable used to start the server when it is not running."
        },
        "testflyInspector.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Run 'mobilecli server start' when a local server does not answer."
        },
        "testflyInspector.autoRefreshAfterAction": {
          "type": "boolean",
          "default": true,
          "description": "Read the screen again after a tap, swipe, text or button action."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.js",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
